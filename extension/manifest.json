{
  "manifest_version": 3,
  "name": "Bookmark Review importer",
  "version": "0.1.0",
  "description": "Sends your X bookmarks and Instagram saved posts to your local Bookmark Review app.",
  "host_permissions": ["http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
